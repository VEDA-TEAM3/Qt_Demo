* {
    font-family: "Segoe UI", "Malgun Gothic";
    font-size: 14px;
    color: #e3edf9;
    background-color: #030a14;
    selection-background-color: #2b78f0;
    selection-color: #ffffff;
}

QMainWindow,
QWidget,
QWidget#centralwidget,
QWidget#mainContent {
    background-color: #030a14;
}

QLabel {
    background-color: transparent;
}

QFrame#sidebarFrame {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #061323, stop:1 #091a2d);
    border-right: 1px solid #314968;
}

QLabel#menuIconLabel {
    color: #a9bad1;
    font-size: 15px;
    font-weight: 800;
    padding: 0 6px 16px 6px;
}

QLabel#navDashboard, QLabel#navCctv, QLabel#navTwin, QLabel#navEvents,
QLabel#navControl, QLabel#navStats, QLabel#navReports, QLabel#navSystem, QLabel#navCollapse {
    color: #b8c7da;
    min-height: 34px;
    padding: 6px 10px;
    border-radius: 7px;
}

QLabel#navDashboard {
    color: #f4f9ff;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1c6ee8, stop:1 #16499d);
    border: 1px solid #65a2ff;
    font-weight: 800;
}

QLabel#navCctv:hover, QLabel#navTwin:hover, QLabel#navEvents:hover,
QLabel#navControl:hover, QLabel#navStats:hover, QLabel#navReports:hover, QLabel#navSystem:hover {
    background-color: #132943;
    color: #ffffff;
}

QLabel#navCollapse {
    color: #8799ad;
    border-top: 1px solid #24364b;
    border-radius: 0;
}

QFrame#topBarFrame {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0c2036, stop:1 #06111f);
    border-top: 1px solid #1b3049;
    border-right: 1px solid #1f344d;
    border-bottom: 1px solid #314968;
    border-left: 1px solid #45627f;
    border-radius: 8px;
}

QLabel#titleLabel {
    color: #ffffff;
    font-size: 25px;
    font-weight: 900;
}

QLabel#dateLabel {
    color: #d5dfec;
    font-family: "Segoe UI", "Malgun Gothic";
    font-size: 14px;
    font-weight: 800;
    min-width: 154px;
}

QLabel#systemStatusLabel {
    color: #d5dfec;
    font-weight: 800;
    padding-left: 14px;
    border-left: 1px solid #2b4058;
}

QLabel#connectionStatusLabel {
    color: #d5dfec;
    font-weight: 800;
    padding-left: 14px;
    border-left: 1px solid #2b4058;
}

QLabel#safeLabel {
    color: #38e86a;
    font-weight: 800;
    padding-right: 14px;
}

QLabel#warnLabel {
    color: #ffd21f;
    font-weight: 800;
    padding-right: 14px;
}

QLabel#dangerLabel {
    color: #ff4b4b;
    font-weight: 800;
    padding-right: 14px;
}

QLabel#separateLabel_1, QLabel#separateLabel_2, QLabel#separateLabel_3 {
    color: #2b4058;
    font-weight: 800;
}

QLabel#settingsLabel {
    color: #e5eefb;
    background-color: #13263c;
    border: 1px solid #476684;
    border-radius: 7px;
    padding: 0;
    font-weight: 800;
}

QLabel#settingsLabel:hover {
    color: #ffffff;
    background-color: #1c3f63;
    border-color: #78baff;
}

QWidget#mapSettingsDialog {
    background-color: rgba(0, 7, 16, 205);
}

QFrame#mapSettingsDialogPanel {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #071728, stop:0.55 #09213a, stop:1 #061523);
    border: 1px solid #2b8cff;
    border-radius: 12px;
}

QLabel#mapSettingsTitleLabel {
    color: #f5f9ff;
    font-size: 24px;
    font-weight: 900;
}

QPushButton#mapSettingsCloseButton {
    min-width: 46px;
    max-width: 46px;
    min-height: 44px;
    max-height: 44px;
    background-color: #0d2239;
    border: 1px solid #315578;
    border-radius: 8px;
    color: #f4f8ff;
    font-size: 24px;
    font-weight: 600;
}

QPushButton#mapSettingsCloseButton:hover {
    background-color: #173b5f;
    border-color: #69b5ff;
}

QFrame#mapSettingsOptionsFrame {
    background-color: rgba(9, 29, 50, 190);
    border: 1px solid #355b7e;
    border-radius: 9px;
}

QLabel#mapSettingsSectionLabel {
    color: #50b7ff;
    font-size: 18px;
    font-weight: 800;
}

QCheckBox#mapSettingsOption {
    color: #e9f2ff;
    background-color: transparent;
    border: 0;
    spacing: 12px;
    min-height: 42px;
    font-size: 17px;
    font-weight: 600;
}

QCheckBox#mapSettingsOption::indicator {
    width: 24px;
    height: 24px;
    border: 2px solid #496986;
    border-radius: 5px;
    background-color: #071522;
}

QCheckBox#mapSettingsOption::indicator:unchecked:hover {
    border-color: #78baff;
    background-color: #0d2841;
}

QCheckBox#mapSettingsOption::indicator:checked {
    border-color: #70c1ff;
    background-color: #167ff0;
}

QCheckBox#mapSettingsOption::indicator:checked:hover {
    border-color: #b8e0ff;
    background-color: #248eff;
}

QPushButton#mapSettingsCancelButton,
QPushButton#mapSettingsApplyButton {
    min-width: 138px;
    min-height: 48px;
    border-radius: 7px;
    font-size: 16px;
    font-weight: 800;
}

QPushButton#mapSettingsCancelButton {
    color: #e4edf8;
    background-color: #0c2035;
    border: 1px solid #3d6285;
}

QPushButton#mapSettingsCancelButton:hover {
    background-color: #173652;
    border-color: #6b9bc4;
}

QPushButton#mapSettingsApplyButton {
    color: #ffffff;
    background-color: #147cf0;
    border: 1px solid #3ca0ff;
}

QPushButton#mapSettingsApplyButton:hover {
    background-color: #258eff;
    border-color: #84c7ff;
}

QFrame#topSectionFrame, QFrame#bottomSectionFrame {
    background-color: transparent;
    border: 0;
}

QFrame#cctvCard, QFrame#mapCard, QFrame#eventLogCard, QFrame#deviceStatusCard,
QFrame#objectListCard, QFrame#legendFrame {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #12263d, stop:0.46 #0c1a2d, stop:1 #071221);
    border: 1px solid #3f5b78;
    border-radius: 8px;
}

QLabel#monitorTitleLabel, QLabel#mapTitleLabel, QLabel#eventLogTitleLabel,
QLabel#deviceStatusTitleLabel, QLabel#objectListTitleLabel {
    color: #ffffff;
    font-size: 16px;
    font-weight: 900;
}

QLabel#cameraSelectLabel {
    background-color: #0d1d31;
    border: 1px solid #476684;
    border-radius: 6px;
    color: #dce8f8;
    padding: 6px 12px;
}

QFrame#mapPlaceholderFrame, QFrame#eventLogBodyFrame, QFrame#deviceStatusBodyFrame,
QFrame#objectListBodyFrame {
    background-color: #06111f;
    border: 1px solid #304966;
    border-radius: 6px;
}

QFrame#deviceStatusBodyFrame {
    background-color: transparent;
    border: 0;
}

QFrame#deviceChannelCard {
    background-color: #07182a;
    border: 1px solid #25527c;
    border-radius: 7px;
}

QFrame#deviceChannelCard[healthState="confirmed"] {
    border-color: #25527c;
}

QFrame#deviceChannelCard[healthState="unknown"],
QFrame#deviceChannelCard[healthState="failed"] {
    border-color: #ff5a5f;
}

QLabel#deviceChannelTitleLabel {
    color: #2ebcff;
    font-size: 12px;
    font-weight: 900;
}

QFrame#deviceStatusRow {
    background-color: #0a1c31;
    border: 1px solid #21405e;
    border-radius: 6px;
    min-height: 28px;
}

QLabel#deviceStatusIconLabel {
    background-color: transparent;
}

QFrame#deviceStatusSeparator {
    background-color: #345575;
    border: 0;
}

QLabel#deviceStateSegment {
    background-color: #07101d;
    border: 1px solid #263a52;
    color: #5f7187;
    font-size: 10px;
    font-weight: 900;
    padding: 2px 3px;
}

QLabel#deviceStateSegment[stateKind="safe"][active="true"],
QLabel#deviceStateSegment[stateKind="off"][active="true"] {
    background-color: #0b3421;
    border-color: #5bff4e;
    color: #5bff4e;
}

QLabel#deviceStateSegment[stateKind="warning"][active="true"] {
    background-color: #332b08;
    border-color: #ffd020;
    color: #ffd020;
}

QLabel#deviceStateSegment[stateKind="danger"][active="true"],
QLabel#deviceStateSegment[stateKind="on"][active="true"] {
    background-color: #351016;
    border-color: #ff4545;
    color: #ff4545;
}

QLabel#deviceStateSegment[stateKind="safe"][active="false"],
QLabel#deviceStateSegment[stateKind="off"][active="false"] {
    color: #245d38;
}

QLabel#deviceStateSegment[stateKind="warning"][active="false"] {
    color: #66571a;
}

QLabel#deviceStateSegment[stateKind="danger"][active="false"],
QLabel#deviceStateSegment[stateKind="on"][active="false"] {
    color: #683035;
}

QTableView#objectListTable, QTableView#eventLogTable {
    background-color: transparent;
    border: 0;
    color: #e5eefb;
    font-size: 12px;
    gridline-color: #304966;
    outline: 0;
}

QTableView#objectListTable::item, QTableView#eventLogTable::item {
    border-bottom: 1px solid #243b56;
    padding: 3px 4px;
}

QTableView#objectListTable QHeaderView::section, QTableView#eventLogTable QHeaderView::section {
    background-color: #0f2034;
    border: 0;
    border-bottom: 1px solid #3f5b78;
    color: #d3dfef;
    font-size: 12px;
    font-weight: 800;
    padding: 4px 4px;
}

DigitalTwinMapWidget#digitalTwinMapWidget {
    background-color: #06111f;
    border: 1px solid #304966;
    border-radius: 6px;
}

QLabel#mapPlaceholderLabel {
    color: #4e6076;
    font-size: 22px;
    font-weight: 900;
}

ClickableVideoWidget {
    background-color: #020712;
    border: 1px solid #304966;
    border-radius: 6px;
}

ClickableVideoWidget[loading="true"] {
    border: 1px solid #4388f2;
}

QFrame#videoTileFrame {
    background-color: #172a40;
    border: 2px solid #172a40;
    border-radius: 6px;
}

QFrame#videoTileFrame[hovered="true"] {
    background-color: #58a6ff;
    border-color: #58a6ff;
}

QFrame#videoLoadingOverlay {
    background-color: #020712;
    border-radius: 6px;
}

QLabel#videoLoadingLabel {
    color: #c8d7ea;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0px;
}

QLabel#legendLabel {
    color: #b9c8da;
    font-weight: 700;
}

QStatusBar, QMenuBar {
    background-color: #030a14;
    color: #aebdd0;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #06111f;
    border: 0;
    width: 10px;
    height: 10px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #476684;
    border-radius: 5px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
