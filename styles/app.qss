* {
    font-family: "Segoe UI", "Malgun Gothic";
    font-size: 14px;
    color: #dce6f2;
    background-color: #050a11;
    selection-background-color: #1976d2;
    selection-color: #ffffff;
}

QMainWindow,
QWidget,
QWidget#centralwidget,
QWidget#mainContent {
    background-color: #050a11;
}

QLabel {
    background-color: transparent;
}

QFrame#sidebarFrame {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #061323, stop:1 #091a2d);
    border-right: 1px solid #314968;
}

QLabel#menuIconLabel {
    color: #a9bad1;
    font-size: 15px;
    font-weight: 800;
    padding: 0 6px 16px 6px;
}

QLabel#navDashboard, QLabel#navCctv, QLabel#navTwin, QLabel#navEvents,
QLabel#navControl, QLabel#navStats, QLabel#navReports, QLabel#navSystem, QLabel#navCollapse {
    color: #b8c7da;
    min-height: 34px;
    padding: 6px 10px;
    border-radius: 7px;
}

QLabel#navDashboard {
    color: #f4f9ff;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1c6ee8, stop:1 #16499d);
    border: 1px solid #65a2ff;
    font-weight: 800;
}

QLabel#navCctv:hover, QLabel#navTwin:hover, QLabel#navEvents:hover,
QLabel#navControl:hover, QLabel#navStats:hover, QLabel#navReports:hover, QLabel#navSystem:hover {
    background-color: #132943;
    color: #ffffff;
}

QLabel#navCollapse {
    color: #8799ad;
    border-top: 1px solid #24364b;
    border-radius: 0;
}

QFrame#topBarFrame {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #101e2d, stop:1 #09131e);
    border: 1px solid #294159;
    border-radius: 8px;
}

QLabel#titleLabel {
    color: #f4f7fb;
    font-size: 25px;
    font-weight: 900;
}

QLabel#dateLabel {
    color: #b9c6d5;
    font-family: "Segoe UI", "Malgun Gothic";
    font-size: 14px;
    font-weight: 800;
    min-width: 154px;
}

QLabel#systemStatusLabel {
    color: #c8d3df;
    font-weight: 800;
    padding-left: 14px;
    border-left: 1px solid #26394c;
}

QLabel#connectionStatusLabel {
    color: #c8d3df;
    font-weight: 800;
    padding-left: 14px;
    border-left: 1px solid #26394c;
}

QLabel#safeLabel {
    color: #38e86a;
    font-weight: 800;
    padding-right: 14px;
}

QLabel#warnLabel {
    color: #ffd21f;
    font-weight: 800;
    padding-right: 14px;
}

QLabel#dangerLabel {
    color: #ff4b4b;
    font-weight: 800;
    padding-right: 14px;
}

QLabel#separateLabel_1, QLabel#separateLabel_2, QLabel#separateLabel_3 {
    color: #2b4058;
    font-weight: 800;
}

QLabel#settingsLabel {
    color: #dce6f2;
    background-color: #101e2d;
    border: 1px solid #36536e;
    border-radius: 7px;
    padding: 0;
    font-weight: 800;
}

QLabel#settingsLabel:hover {
    color: #ffffff;
    background-color: #17324b;
    border-color: #55aef5;
}

QWidget#mapSettingsDialog {
    background-color: rgba(0, 7, 16, 205);
}

QFrame#mapSettingsDialogPanel {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0b1723, stop:0.55 #102235, stop:1 #091522);
    border: 1px solid #328fdb;
    border-radius: 12px;
}

QLabel#mapSettingsTitleLabel {
    color: #f5f9ff;
    font-size: 24px;
    font-weight: 900;
}

QPushButton#mapSettingsCloseButton {
    min-width: 46px;
    max-width: 46px;
    min-height: 44px;
    max-height: 44px;
    background-color: #0d2239;
    border: 1px solid #315578;
    border-radius: 8px;
    color: #f4f8ff;
    font-size: 24px;
    font-weight: 600;
}

QPushButton#mapSettingsCloseButton:hover {
    background-color: #173b5f;
    border-color: #69b5ff;
}

QFrame#mapSettingsOptionsFrame {
    background-color: rgba(10, 23, 36, 220);
    border: 1px solid #2e4b64;
    border-radius: 9px;
}

QLabel#mapSettingsSectionLabel {
    color: #50b7ff;
    font-size: 18px;
    font-weight: 800;
}

QCheckBox#mapSettingsOption {
    color: #e9f2ff;
    background-color: transparent;
    border: 0;
    spacing: 12px;
    min-height: 42px;
    font-size: 17px;
    font-weight: 600;
}

QCheckBox#mapSettingsOption::indicator {
    width: 24px;
    height: 24px;
    border: 2px solid #496986;
    border-radius: 5px;
    background-color: #071522;
}

QCheckBox#mapSettingsOption::indicator:unchecked:hover {
    border-color: #78baff;
    background-color: #0d2841;
}

QCheckBox#mapSettingsOption::indicator:checked {
    border-color: #70c1ff;
    background-color: #167ff0;
}

QCheckBox#mapSettingsOption::indicator:checked:hover {
    border-color: #b8e0ff;
    background-color: #248eff;
}

QPushButton#mapSettingsCancelButton,
QPushButton#mapSettingsApplyButton {
    min-width: 138px;
    min-height: 48px;
    border-radius: 7px;
    font-size: 16px;
    font-weight: 800;
}

QPushButton#mapSettingsCancelButton {
    color: #e4edf8;
    background-color: #0c2035;
    border: 1px solid #3d6285;
}

QPushButton#mapSettingsCancelButton:hover {
    background-color: #173652;
    border-color: #6b9bc4;
}

QPushButton#mapSettingsApplyButton {
    color: #ffffff;
    background-color: #147cf0;
    border: 1px solid #3ca0ff;
}

QPushButton#mapSettingsApplyButton:hover {
    background-color: #258eff;
    border-color: #84c7ff;
}

QFrame#topSectionFrame, QFrame#bottomSectionFrame {
    background-color: transparent;
    border: 0;
}

QFrame#cctvCard, QFrame#mapCard, QFrame#eventLogCard, QFrame#deviceStatusCard,
QFrame#objectListCard, QFrame#legendFrame {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #102235, stop:0.5 #0b1826, stop:1 #08121d);
    border: 1px solid #2d4962;
    border-radius: 8px;
}

QLabel#monitorTitleLabel, QLabel#mapTitleLabel, QLabel#eventLogTitleLabel,
QLabel#deviceStatusTitleLabel, QLabel#objectListTitleLabel {
    color: #f3f6fa;
    font-size: 16px;
    font-weight: 800;
}

QLabel#cameraSelectLabel {
    background-color: #0a1623;
    border: 1px solid #35536e;
    border-radius: 6px;
    color: #d1dbe7;
    padding: 6px 12px;
}

QFrame#mapPlaceholderFrame, QFrame#eventLogBodyFrame, QFrame#deviceStatusBodyFrame,
QFrame#objectListBodyFrame {
    background-color: #07111b;
    border: 1px solid #243c52;
    border-radius: 6px;
}

QFrame#deviceStatusBodyFrame {
    background-color: transparent;
    border: 0;
}

QFrame#deviceChannelCard {
    background-color: #081725;
    border: 1px solid #285173;
    border-radius: 7px;
}

QFrame#deviceChannelCard[healthState="confirmed"] {
    border-color: #25527c;
}

QFrame#deviceChannelCard[healthState="failed"] {
    border-color: #ff2f3d;
}

QLabel#deviceChannelTitleLabel {
    color: #2ebcff;
    font-size: 12px;
    font-weight: 900;
}

QFrame#deviceStatusRow {
    background-color: #091725;
    border: 1px solid #203c54;
    border-radius: 6px;
    min-height: 28px;
}

QLabel#deviceStatusIconLabel {
    background-color: transparent;
}

QFrame#deviceStatusSeparator {
    background-color: #345575;
    border: 0;
}

QLabel#deviceStateSegment {
    background-color: #060e17;
    border: 1px solid #25394c;
    color: #607184;
    font-size: 10px;
    font-weight: 900;
    padding: 2px 3px;
}

QLabel#deviceStateSegment[stateKind="safe"][active="true"],
QLabel#deviceStateSegment[stateKind="off"][active="true"] {
    background-color: #0b3421;
    border-color: #5bff4e;
    color: #5bff4e;
}

QLabel#deviceStateSegment[stateKind="warning"][active="true"] {
    background-color: #332b08;
    border-color: #ffd020;
    color: #ffd020;
}

QLabel#deviceStateSegment[stateKind="danger"][active="true"],
QLabel#deviceStateSegment[stateKind="on"][active="true"] {
    background-color: #390e16;
    border-color: #ff2f3d;
    color: #ff4b56;
}

QLabel#deviceStateSegment[stateKind="safe"][active="false"],
QLabel#deviceStateSegment[stateKind="off"][active="false"] {
    color: #245d38;
}

QLabel#deviceStateSegment[stateKind="warning"][active="false"] {
    color: #66571a;
}

QLabel#deviceStateSegment[stateKind="danger"][active="false"],
QLabel#deviceStateSegment[stateKind="on"][active="false"] {
    color: #683035;
}

QTableView#objectListTable, QTableView#eventLogTable {
    background-color: transparent;
    border: 0;
    color: #dce6f2;
    font-size: 12px;
    gridline-color: #263f55;
    outline: 0;
}

QTableView#objectListTable::item, QTableView#eventLogTable::item {
    border-bottom: 1px solid #1f3549;
    padding: 3px 4px;
}

QTableView#objectListTable QHeaderView::section, QTableView#eventLogTable QHeaderView::section {
    background-color: #0c1a28;
    border: 0;
    border-bottom: 1px solid #31516c;
    color: #c8d4e1;
    font-size: 12px;
    font-weight: 800;
    padding: 4px 4px;
}

QWidget#eventLogScrollHeaderCover {
    background-color: #0c1a28;
    border: 0;
    border-bottom: 1px solid #31516c;
}

DigitalTwinMapWidget#digitalTwinMapWidget {
    background-color: #06101a;
    border: 1px solid #263f55;
    border-radius: 6px;
}

QLabel#mapPlaceholderLabel {
    color: #4e6076;
    font-size: 22px;
    font-weight: 900;
}

ClickableVideoWidget {
    background-color: #02060b;
    border: 1px solid #263f55;
    border-radius: 6px;
}

ClickableVideoWidget[loading="true"] {
    border: 1px solid #4388f2;
}

QFrame#videoTileFrame {
    background-color: #152638;
    border: 2px solid #152638;
    border-radius: 6px;
}

QFrame#videoTileFrame[hovered="true"] {
    background-color: #45a7ef;
    border-color: #45a7ef;
}

QFrame#videoLoadingOverlay {
    background-color: #02060b;
    border-radius: 6px;
}

QLabel#videoLoadingLabel {
    color: #c8d7ea;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0px;
}

QLabel#legendLabel {
    color: #aebdcd;
    font-weight: 700;
}

QStatusBar, QMenuBar {
    background-color: #050a11;
    color: #aebdd0;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #07111b;
    border: 0;
    width: 10px;
    height: 10px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #3a5d78;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #4d7898;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
